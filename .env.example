# Copy to .env and fill in. Every variable the dashboard server reads is listed here.

# HTTP port the dashboard listens on.
PORT=5177

# "local"  -> dashboard talks to an ESP32 CAN logger on the LAN
# "cloud"  -> the ESP32 POSTs status updates to this dashboard; login is always required
DASHBOARD_MODE=local

# Shared bearer token the ESP32 must send (Authorization: Bearer <token> or
# X-Device-Token) when POSTing to /api/cloud/status. REQUIRED whenever auth is on
# (cloud mode, or DASHBOARD_AUTH left on): an unset token makes that endpoint 503.
# The devices row for this ESP32 stores sha256(this token) in upload_token_hash.
DEVICE_UPLOAD_TOKEN=replace-with-a-long-random-token

# --- Supabase (Auth + Postgres + RLS) -------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# anon / publishable key. Used for user password login, token refresh, and every
# per-request user read (RLS applies).
SUPABASE_ANON_KEY=
# service-role key. BYPASSES RLS. Used only for ESP32 ingestion (POST
# /api/cloud/status) and the device->user attribution lookup. Never for user reads.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random bytes. The AES-256-GCM key for the stateless session cookie is
# derived from this (scrypt). Rotating it logs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_COOKIE_SECRET=

# Set to "off" to disable the login requirement entirely (trusted local network
# only). Any other value (or unset) keeps auth on in cloud mode or when Supabase
# is configured.
DASHBOARD_AUTH=

# Customer identifier shown in the dashboard UI.
CUSTOMER_ID=CANLOGGER-001

# Default logger address used in local mode until changed in Settings.
CAN_LOGGER_ADDRESS=canlogger.local

# Default device / vehicle display name.
DEVICE_NAME=Family Vehicle
